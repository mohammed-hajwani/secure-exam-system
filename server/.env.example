# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:MyNewPass123@localhost:5432/secure_exam_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super_secret_access_key_change_in_production"
JWT_REFRESH_SECRET="super_secret_refresh_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP Email Configuration (for OTP delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="Secure Exam System <no-reply@exam-system.edu>"
